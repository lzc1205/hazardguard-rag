# ---------------------------------------------------------------------------
# Docker Compose 环境变量
#
# 复制为根目录的 .env 后填写：cp .env.example .env
#
# 注意：Compose 只自动读**根目录**的 .env；
#       backend/.env 是后端进程自己读的，两者可以只填一份。
# ---------------------------------------------------------------------------

# ---------- 大模型（必填，否则降级为规则模式） ----------
# 未配置时系统不会崩，但审查说理会退化成模板拼接，质量明显下降。
# DeepSeek 便宜且够用，推荐：
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- 向量化 ----------
# 本项目实际使用字符 n-gram 方案（零依赖、离线可用、512 维）。
# 详见 backend/.env.example 的说明，不建议改动。
EMBEDDING_PROVIDER=char
EMBEDDING_DIMENSION=512

# ---------- 初始管理员 ----------
# 首次启动时 init_db.py 会用这组账号创建管理员（已存在则跳过）。
# ⚠️ 部署到公网前务必修改密码，并同步改 JWT_SECRET_KEY。
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
JWT_SECRET_KEY=change-me-in-production
