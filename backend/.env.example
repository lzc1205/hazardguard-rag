# ---------------------------------------------------------------------------
# HazardGuard-RAG 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# ---------------------------------------------------------------------------

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hazardguard

# ---------- 缓存 ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 鉴权 ----------
# 生产环境务必替换：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 大模型（OpenAI 兼容接口） ----------
# 国内模型只需换 BASE_URL 即可，例如：
#   DeepSeek: https://api.deepseek.com/v1
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# ---------- 向量化（Embedding） ----------
# 本项目实际使用【字符 n-gram】方案，不是任何第三方向量模型。
# 原理见 app/rag/embedding.py 的 CharSemanticEmbedding：
#   提取中文 1/2/3-gram 字符特征 → TF-IDF 加权 → L2 归一化 → 512 维
# 优势：零外部依赖（不需要 torch / 2GB 模型下载）、毫秒级、离线可用。
# 代价：同义改写的泛化能力弱于真实语义模型，因此采用
#      「字符向量 + BM25」双路 RRF 融合互补，而非替代。
#
# 可选：改成 openai 可切换到 OpenAI 兼容的向量接口
# （复用上面的 LLM_BASE_URL / LLM_API_KEY，通义千问等同样支持）
# ⚠️ 切换后必须执行 POST /api/v1/vector/reindex 全量重建向量，
#    新旧模型语义空间不同，混存会导致检索完全失真。
EMBEDDING_PROVIDER=char
EMBEDDING_DIMENSION=512
# 仅 EMBEDDING_PROVIDER=openai 时生效
EMBEDDING_MODEL=text-embedding-3-large

# ---------- 向量库 ----------
# 只有 PGVector 一种实现：向量存于 PostgreSQL 的 knowledge_chunks.embedding
# 列（VECTOR(512) + HNSW 索引），随数据库一起持久化。

# ---------- 检索与分块 ----------
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64
RETRIEVER_TOP_K=20
# 混合检索权重：向量路 0.55 / BM25 路 0.45（RRF 融合，K=60）
HYBRID_W_VECTOR=0.55
HYBRID_W_BM25=0.45
# 规则加权前的候选池倍数：目标条款若不在池内就无法重排进 Top5
RETRIEVER_POOL_MULTIPLIER=6

# ---------- 上传与安全 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ---------- 初始管理员（首次 seed 时创建） ----------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

DEBUG=true